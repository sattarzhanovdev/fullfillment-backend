// Prisma schema draft — Fulfillment FBO/FBS system
// Will be copied into backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  DIRECTOR
  MANAGER
  STOREKEEPER
  PACKER
  CLIENT
}

enum ClientType {
  IP
  OOO
}

enum ClientStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

enum Marketplace {
  WILDBERRIES
  OZON
  YANDEX_MARKET
  MEGAMARKET
  OTHER
}

enum CellType {
  SHELF
  FLOOR
  RETURNS
  PICKING
}

enum ReceiptStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FunnelStatus {
  NEW_REQUEST
  AWAITING_RECEIPT
  RECEIVING
  RECEIVED
  AWAITING_PROCESSING
  IN_PROGRESS
  PICKING
  PICKED
  PACKING
  PACKED
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
  ERROR
  ITEM_NOT_FOUND
  NEEDS_PRICE
  BLOCKED_DEBT
  NEEDS_CLARIFICATION
}

enum SupplyStatus {
  DRAFT
  CREATED
  PICKING
  PICKED
  PACKING
  READY
  SHIPPED
  ACCEPTED_BY_MARKETPLACE
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PLANNED
  IN_PROGRESS
  SHIPPED
  COMPLETED
  CANCELLED
  OVERDUE
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InventoryScope {
  WAREHOUSE
  CLIENT
  ZONE
  CELL
  PRODUCTS
}

enum MovementStatus {
  PENDING
  COMPLETED
}

enum DocumentType {
  CONTRACT
  ACT
  INVOICE
  UPD
  WAYBILL
  RECEIPT_ACT
  DISCREPANCY_ACT
  REPORT
  OTHER
}

enum NotificationType {
  NEW_ORDER
  DEADLINE
  OVERDUE
  LOW_STOCK
  ITEM_NOT_FOUND
  DISCREPANCY
  DEBT
  LIMIT_EXCEEDED
  INTEGRATION_ERROR
  SUPPLY_READY
  MARKETPLACE_ERROR
  NEW_DOCUMENT
}

enum DebtState {
  NORMAL
  WARNING
  CRITICAL
  BLOCKED
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  SYNCING
}

// ---------- Users & Auth ----------

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  role             UserRole
  clientId         String? // set when role = CLIENT
  client           Client?   @relation("ClientUsers", fields: [clientId], references: [id])
  managedClients   Client[]  @relation("ClientManager")
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  refreshTokenHash String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignedOrders   MarketplaceOrder[] @relation("OrderAssignee")
  assignedSupplies Supply[]           @relation("SupplyAssignee")
  auditLogs        AuditLog[]
  notifications    Notification[]
  movements        Movement[]
  receipts         Receipt[]
  inventoryCounts  InventoryCount[]
}

// ---------- Clients ----------

model Client {
  id            String       @id @default(cuid())
  name          String
  type          ClientType   @default(IP)
  managerId     String?
  manager       User?        @relation("ClientManager", fields: [managerId], references: [id])
  status        ClientStatus @default(ACTIVE)
  debtLimit     Decimal      @default(10000) @db.Decimal(12, 2)
  bufferPercent Decimal?     @db.Decimal(5, 2) // null = use general
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users            User[]                   @relation("ClientUsers")
  requisites       ClientRequisites?
  contract         Contract?
  products         Product[]
  receipts         Receipt[]
  inventoryCounts  InventoryCount[]
  orders           MarketplaceOrder[]
  supplies         Supply[]
  clientPrice      ClientPrice?
  debtEntries      DebtLedgerEntry[]
  marketplaceLinks MarketplaceIntegration[]
  telegramLink     TelegramLink?
  documents        Document[]
  reservations     Reservation[]
  stocks           Stock[]
  shipments        Shipment[]
}

model ClientRequisites {
  id            String   @id @default(cuid())
  clientId      String   @unique
  client        Client   @relation(fields: [clientId], references: [id])
  legalName     String
  inn           String
  ogrn          String?
  legalAddress  String?
  actualAddress String?
  phone         String?
  email         String?
  bankName      String?
  bankAccount   String?
  bankBik       String?
  contactPerson String?
  updatedAt     DateTime @updatedAt
}

model Contract {
  id         String         @id @default(cuid())
  clientId   String         @unique
  client     Client         @relation(fields: [clientId], references: [id])
  number     String
  date       DateTime
  startDate  DateTime
  termMonths Int?
  tariff     String?
  terms      String?
  status     ContractStatus @default(DRAFT)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// ---------- Products ----------

model Product {
  id                 String         @id @default(cuid())
  clientId           String
  client             Client         @relation(fields: [clientId], references: [id])
  name               String
  sku                String
  article            String
  barcode            String
  category           String?
  photoUrl           String?
  lengthCm           Decimal?       @db.Decimal(8, 2)
  widthCm            Decimal?       @db.Decimal(8, 2)
  heightCm           Decimal?       @db.Decimal(8, 2)
  weightKg           Decimal?       @db.Decimal(8, 3)
  packagingTypeId    String?
  packagingType      PackagingType? @relation(fields: [packagingTypeId], references: [id])
  ownPrice           Decimal?       @db.Decimal(10, 2) // "Цена конкретного товара"
  fbsProcessingPrice Decimal?       @db.Decimal(10, 2)
  bufferPercent      Decimal?       @db.Decimal(5, 2) // manual override, highest priority
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  stocks       Stock[]
  orderItems   OrderItem[]
  supplyItems  SupplyItem[]
  receiptItems ReceiptItem[]
  history      ProductHistoryEntry[]
  movements    Movement[]

  @@unique([clientId, article])
  @@index([barcode])
}

model ProductHistoryEntry {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  delta     Int
  reason    String
  reference String?
  userId    String?
  createdAt DateTime @default(now())
}

// ---------- Warehouse / address storage ----------

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  zones     Zone[]
  receipts  Receipt[]
  shipments Shipment[]
}

model Zone {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String
  name        String?
  isReturns   Boolean   @default(false)

  cells Cell[]

  @@unique([warehouseId, code])
}

model Cell {
  id       String   @id @default(cuid())
  zoneId   String
  zone     Zone     @relation(fields: [zoneId], references: [id])
  code     String // e.g. A-01-02
  type     CellType @default(SHELF)
  capacity Int?
  isActive Boolean  @default(true)

  stocks       Stock[]
  movementsOut Movement[] @relation("MovementFromCell")
  movementsIn  Movement[] @relation("MovementToCell")

  @@unique([zoneId, code])
}

// ---------- Stock & reservations ----------

model Stock {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  cellId      String
  cell        Cell     @relation(fields: [cellId], references: [id])
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  physicalQty Int      @default(0)
  reservedQty Int      @default(0)
  blockedQty  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([productId, cellId])
}

model Reservation {
  id         String            @id @default(cuid())
  productId  String
  clientId   String
  client     Client            @relation(fields: [clientId], references: [id])
  orderId    String?
  order      MarketplaceOrder? @relation(fields: [orderId], references: [id])
  supplyId   String?
  supply     Supply?           @relation(fields: [supplyId], references: [id])
  qty        Int
  isReleased Boolean           @default(false)
  createdAt  DateTime          @default(now())
  releasedAt DateTime?
}

// ---------- Receiving ----------

model Receipt {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  warehouseId    String
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  documentNumber String?
  date           DateTime      @default(now())
  expectedPlaces Int?
  expectedItems  Int?
  status         ReceiptStatus @default(DRAFT)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items ReceiptItem[]
}

model ReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  receipt     Receipt @relation(fields: [receiptId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  expectedQty Int
  actualQty   Int     @default(0)
  discrepancy Int     @default(0)
  cellId      String?
}

// ---------- Movements & inventory ----------

model Movement {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id])
  fromCellId String
  fromCell   Cell           @relation("MovementFromCell", fields: [fromCellId], references: [id])
  toCellId   String
  toCell     Cell           @relation("MovementToCell", fields: [toCellId], references: [id])
  qty        Int
  status     MovementStatus @default(COMPLETED)
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now())
}

model InventoryCount {
  id          String         @id @default(cuid())
  scope       InventoryScope
  warehouseId String?
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id])
  zoneId      String?
  cellId      String?
  status      String         @default("in_progress")
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  lines InventoryLine[]
}

model InventoryLine {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id])
  productId        String
  systemQty        Int
  actualQty        Int?
  discrepancy      Int?
}

// ---------- Packaging ----------

model PackagingType {
  id         String   @id @default(cuid())
  name       String
  kind       String // пакет/коробка/конверт/стрейч/паллета/индивидуальная
  lengthCm   Decimal? @db.Decimal(8, 2)
  widthCm    Decimal? @db.Decimal(8, 2)
  heightCm   Decimal? @db.Decimal(8, 2)
  weightKg   Decimal? @db.Decimal(8, 3)
  cost       Decimal  @default(0) @db.Decimal(10, 2)
  maxVolumeL Decimal? @db.Decimal(10, 2)
  isActive   Boolean  @default(true)

  products Product[]
  orders   MarketplaceOrder[]
}

// ---------- FBS Orders ----------

model MarketplaceOrder {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  marketplace       Marketplace
  shipmentRefNumber String?
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  status            FunnelStatus   @default(NEW_REQUEST)
  priority          OrderPriority  @default(NORMAL)
  assigneeId        String?
  assignee          User?          @relation("OrderAssignee", fields: [assigneeId], references: [id])
  processingCost    Decimal?       @db.Decimal(10, 2)
  deliveryCost      Decimal?       @db.Decimal(10, 2)
  packagingTypeId   String?
  packagingType     PackagingType? @relation(fields: [packagingTypeId], references: [id])
  deadline          DateTime?
  orderedAt         DateTime       @default(now())
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reservations  Reservation[]
  shipment      Shipment?            @relation(fields: [shipmentId], references: [id])
  shipmentId    String?
}

model OrderItem {
  id        String           @id @default(cuid())
  orderId   String
  order     MarketplaceOrder @relation(fields: [orderId], references: [id])
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  cellId    String?
  qtyNeeded Int
  qtyPicked Int              @default(0)
  qtyPacked Int              @default(0)
  notFound  Boolean          @default(false)
}

model OrderStatusHistory {
  id        String           @id @default(cuid())
  orderId   String
  order     MarketplaceOrder @relation(fields: [orderId], references: [id])
  status    FunnelStatus
  userId    String?
  createdAt DateTime         @default(now())
}

// ---------- FBO Supplies ----------

model Supply {
  id                   String       @id @default(cuid())
  supplyNumber         String       @unique
  clientId             String
  client               Client       @relation(fields: [clientId], references: [id])
  marketplace          Marketplace
  marketplaceWarehouse String?
  status               SupplyStatus @default(DRAFT)
  assigneeId           String?
  assignee             User?        @relation("SupplyAssignee", fields: [assigneeId], references: [id])
  deadline             DateTime?
  boxesCount           Int?
  palletsCount         Int?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  items         SupplyItem[]
  statusHistory SupplyStatusHistory[]
  reservations  Reservation[]
  shipment      Shipment?             @relation(fields: [shipmentId], references: [id])
  shipmentId    String?
}

model SupplyItem {
  id        String  @id @default(cuid())
  supplyId  String
  supply    Supply  @relation(fields: [supplyId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qtyNeeded Int
  qtyPicked Int     @default(0)
}

model SupplyStatusHistory {
  id        String       @id @default(cuid())
  supplyId  String
  supply    Supply       @relation(fields: [supplyId], references: [id])
  status    SupplyStatus
  userId    String?
  createdAt DateTime     @default(now())
}

// ---------- Shipments ----------

model Shipment {
  id                String         @id @default(cuid())
  barcode           String         @unique
  /**
   * Одна отгрузка = один продавец: у WB "поставка" привязана к одному API-ключу/аккаунту.
   */
  clientId          String?
  client            Client?        @relation(fields: [clientId], references: [id])
  /**
   * id реальной поставки в WB (после POST /api/v3/supplies) — если у клиента подключён WB API.
   */
  wbSupplyId        String?        @unique
  /**
   * Пункт и способ отгрузки WB — обязателен, чтобы закрыть поставку (deliver) и получить штрихкод.
   */
  wbShippingPointId Int?
  wbShippingType    String?
  marketplace       Marketplace?
  warehouseId       String?
  warehouse         Warehouse?     @relation(fields: [warehouseId], references: [id])
  scheduledAt       DateTime
  transport         String?
  driverName        String?
  status            ShipmentStatus @default(PLANNED)
  boxesCount        Int?
  totalWeightKg     Decimal?       @db.Decimal(10, 2)
  totalVolumeL      Decimal?       @db.Decimal(10, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  orders   MarketplaceOrder[]
  supplies Supply[]
}

// ---------- Pricing ----------

model PriceRule {
  id              String   @id @default(cuid())
  name            String   @default("general")
  firstLiterPrice Decimal  @db.Decimal(10, 2)
  nextLiterPrice  Decimal  @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt
}

model ClientPrice {
  id              String   @id @default(cuid())
  clientId        String   @unique
  client          Client   @relation(fields: [clientId], references: [id])
  flatPrice       Decimal? @db.Decimal(10, 2) // explicit 0 = free, null = use general
  firstLiterPrice Decimal? @db.Decimal(10, 2)
  nextLiterPrice  Decimal? @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt
}

// ---------- Debt / billing ----------

model DebtLedgerEntry {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  amount    Decimal  @db.Decimal(12, 2) // positive = charge, negative = payment
  reason    String
  reference String?
  createdAt DateTime @default(now())
}

// ---------- Marketplace integrations & Telegram ----------

model MarketplaceIntegration {
  id            String            @id @default(cuid())
  clientId      String
  client        Client            @relation(fields: [clientId], references: [id])
  marketplace   Marketplace
  apiKey        String?
  warehouseId   String?
  marketplaceId String?
  status        IntegrationStatus @default(NOT_CONNECTED)
  lastSyncAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([clientId, marketplace])
}

model TelegramLink {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id])
  chatId         String?
  username       String?
  notifyNewOrder Boolean  @default(true)
  notifyPicked   Boolean  @default(true)
  notifyPacked   Boolean  @default(true)
  notifyShipped  Boolean  @default(true)
  notifyLowStock Boolean  @default(true)
  notifyDebt     Boolean  @default(true)
  notifyErrors   Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ---------- Documents ----------

model Document {
  id        String       @id @default(cuid())
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id])
  type      DocumentType
  title     String
  fileUrl   String
  createdAt DateTime     @default(now())
}

// ---------- Notifications ----------

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  clientId  String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

// ---------- Settings ----------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Audit log ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  device     String?
  ip         String?
  createdAt  DateTime @default(now())
}
