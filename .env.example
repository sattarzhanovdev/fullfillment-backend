DATABASE_URL="postgresql://wb_app:wb_app_local_pw@localhost:5432/wb_fulfillment?schema=public"

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_me"
JWT_REFRESH_EXPIRES_IN="7d"

REDIS_HOST=localhost
REDIS_PORT=6379

CORS_ORIGIN="http://localhost:3000"
# true — только если фронтенд и бэкенд на РАЗНЫХ доменах (например Netlify + отдельный PaaS).
# Если оба за одним nginx на одном origin (VPS) — оставить false.
COOKIE_CROSS_SITE=false

STORAGE_DIR="./storage"

TELEGRAM_BOT_TOKEN=""
WB_API_BASE_URL="https://suppliers-api.wildberries.ru"
OZON_API_BASE_URL="https://api-seller.ozon.ru"
